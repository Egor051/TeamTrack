{
  "name": "tasktrace",
  "main": "expo-router/entry",
  "version": "1.0.0",
  "dependencies": {
    "@react-native-async-storage/async-storage": "~2.2.0",
    "@react-native-community/netinfo": "12.0.1",
    "@supabase/supabase-js": "^2.114.0",
    "expo": "~57.0.31",
    "expo-constants": "~57.0.17",
    "expo-crypto": "~57.0.4",
    "expo-font": "~57.0.3",
    "expo-linking": "~57.0.13",
    "expo-router": "~57.0.29",
    "expo-secure-store": "~57.0.4",
    "expo-splash-screen": "~57.0.10",
    "expo-sqlite": "~57.0.4",
    "expo-status-bar": "~57.0.1",
    "expo-system-ui": "~57.0.4",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-web": "~0.21.0",
    "react-native-worklets": "0.10.1"
  },
  "devDependencies": {
    "@types/node": "^22.20.4",
    "@types/react": "~19.2.2",
    "@types/react-test-renderer": "19.1.0",
    "eslint": "^9.0.0",
    "eslint-config-expo": "~57.0.2",
    "fake-indexeddb": "^6.2.4",
    "pg": "8.23.0",
    "playwright": "1.58.0",
    "react-test-renderer": "19.2.3",
    "typescript": "~6.0.3",
    "vitest": "5.0.3",
    "workbox-build": "7.4.1"
  },
  "overrides": {
    "decode-uri-component": "0.5.0",
    "uuid": "11.1.1",
    "vite": {
      ".": "8.3.3",
      "rolldown": {
        ".": "1.2.11",
        "magic-string": "1.4.2"
      }
    }
  },
  "scripts": {
    "start": "expo start --localhost",
    "android": "expo start --localhost --android",
    "ios": "expo start --localhost --ios",
    "web": "expo start --localhost --web",
    "build:web": "node scripts/security-export.mjs --platform web --clear --output-dir dist && node scripts/generate-service-worker.mjs",
    "serve:web": "node scripts/serve-web.mjs",
    "smoke:phase6:browser": "node scripts/phase6-browser-smoke.mjs",
    "smoke:offline:browser": "node scripts/account-offline-browser-smoke.mjs",
    "smoke:offline:performance": "node scripts/build-phase6-local-smoke.mjs && node scripts/offline-navigation-browser-smoke.mjs",
    "lint": "expo lint",
    "typecheck": "tsc --noEmit",
    "check:db": "node scripts/check-db-connections.mjs",
    "test": "npm run check:db && npm run typecheck && npm run lint && npm run test:unit",
    "test:unit": "vitest run",
    "test:sql": "node scripts/run-sql-tests.mjs",
    "test:sql:isolated": "node scripts/run-audit-sql-tests.mjs",
    "test:security": "node scripts/test-security-hardening.mjs && node scripts/test-security-hardening.mjs --hosted",
    "test:backend:isolated": "node scripts/run-security-integrations.mjs",
    "test:backend": "node scripts/run-backend-integration-tests.mjs && node scripts/run-pkce-integration-tests.mjs && node scripts/run-concurrency-tests.mjs && node scripts/run-bootstrap-integration-tests.mjs",
    "gen:types": "node scripts/gen-types.mjs"
  },
  "private": true
}
