# TaskTrace — Supabase environment configuration.
#
# Client-side configuration only. Everything prefixed EXPO_PUBLIC_ is statically
# inlined into the app bundle by Expo, so it must be the PUBLIC publishable
# (anon) key — never a secret. All secrets are enforced server-side via RLS.
#
# Copy this file to `.env` and fill in your project values.

# Supabase project URL, e.g. https://abcdefghijklm.supabase.co
EXPO_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co

# Supabase anon / publishable key (public, designed for use with RLS).
EXPO_PUBLIC_SUPABASE_ANON_KEY=YOUR_ANON_KEY

# ---------------------------------------------------------------------------
# Server-side / local-only values. These are NOT prefixed with EXPO_PUBLIC_
# and therefore never end up in the mobile/web bundle. Used only by
# `npm run gen:types` to regenerate src/types/database.types.ts from the
# running database. Never commit the real values.
# ---------------------------------------------------------------------------

# Direct PostgreSQL connection string used by `supabase gen types` against
# your LOCAL supabase stack (default port 54322) or any other database that
# has the TaskTrace migrations applied.
SUPABASE_DB_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres

# Alternative: generate types from a hosted project via the Supabase CLI.
# Requires: supabase login + supabase link --project-ref <ref>
SUPABASE_PROJECT_ID=YOUR_PROJECT_REF